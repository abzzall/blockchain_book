# Copy this file to .env and fill it in. .env itself is gitignored.
#
# EVERYTHING IN THIS FILE REACHES THE BROWSER. Vite embeds any variable whose
# name begins with VITE_ into the JavaScript it ships, so these values are
# readable by anyone who opens the page. Put only public facts here.
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337

# NEVER put any of the following in this file, or in any file named VITE_*:
#   a private key, a mnemonic or recovery phrase, a deployer key,
#   an API key you pay for, a database URL, a session secret.
# A secret that a browser can read is not a secret. See chapter 20.
